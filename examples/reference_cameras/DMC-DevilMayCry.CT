[ENABLE]

local processName = "DMC-DevilMayCry.exe"
local function onTimer_Tick(timer)
  if readInteger(processName) == nil then
    local processId = getProcessIDFromProcessName(processName)
    if processId and processId ~= getOpenedProcessID() then
      openProcess(processId)
    end
  end
end
local autoAttachTimer = createTimer(getMainForm(), true)
autoAttachTimer.Interval = 1000
autoAttachTimer.OnTimer = onTimer_Tick

[DISABLE]

</AssemblerScript>
    </CheatEntry>
    <CheatEntry>
      <ID>26229</ID>
      <Description>"Camera - Leave On"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]

aobscanmodule(Camera,DMC-DevilMayCry.exe,8D B3 6C 05 00 00) // should be unique
alloc(newmem,$1000,Camera)

label(code)
label(return)
label(pCamera)

newmem:
mov [pCamera], ebx

code:
  lea esi,[ebx+0000056C]
  jmp return

pCamera:
  dd 0

Camera:
  jmp newmem
  nop

return:
registersymbol(Camera)
registersymbol(pCamera)

{$lua}
function getCamBase()
    local symbolAddress = getAddressSafe("pCamera")
    if not symbolAddress then return nil end

    local cameraAddress = readInteger(symbolAddress)
    if not cameraAddress or cameraAddress == 0 then return nil end

    return cameraAddress
end

function toDegrees(v)
    if v == nil then return 0 end
    return (v / 32768) * 180
end

speedFast  = 3
speedSlow  = 1
speedSlow2 = 0.5

function checkKeys()
    local cam = getCamBase()
    if not cam then return end

    if getOpenedProcessID() ~= getForegroundProcess() then
        return
    end

    local speed = speedFast
    if isKeyPressed(VK_LCONTROL) then
        speed = speedSlow
    elseif isKeyPressed(VK_LMENU) then
        speed = speedSlow2
    end

    local pitchI = readInteger(cam + 0x578)
    local yawI   = readInteger(cam + 0x57C)
    local rollI  = readInteger(cam + 0x580)

    local x = readFloat(cam + 0x56C)
    local y = readFloat(cam + 0x570)
    local z = readFloat(cam + 0x574)

    local fov = readFloat(cam + 0x584)

    if pitchI == nil or yawI == nil or rollI == nil or
       x == nil or y == nil or z == nil then
        return
    end

    local yaw = math.rad(toDegrees(yawI))
    local siny = math.sin(yaw)
    local cosy = math.cos(yaw)

    local rotationStep = math.max(1, math.floor(speed * 40))
    local rollStep = math.max(1, math.floor(speed * 20))

        if isKeyPressed(VK_UP) then
            writeInteger(cam + 0x578, pitchI + rotationStep)
        end

        if isKeyPressed(VK_DOWN) then
            writeInteger(cam + 0x578, pitchI - rotationStep)
        end

        if isKeyPressed(VK_LEFT) then
            writeInteger(cam + 0x57C, yawI - rotationStep)
        end

        if isKeyPressed(VK_RIGHT) then
            writeInteger(cam + 0x57C, yawI + rotationStep)
        end

        if isKeyPressed(VK_SUBTRACT) then
            writeFloat(cam + 0x584, fov - (speed * 0.25))
        end

        if isKeyPressed(VK_ADD) then
            writeFloat(cam + 0x584, fov + (speed * 0.25))
        end

        if isKeyPressed(VK_NUMPAD8) then
            writeFloat(cam + 0x56C, x + cosy * speed)
            writeFloat(cam + 0x570, y + siny * speed)
        end

        if isKeyPressed(VK_NUMPAD5) then
            writeFloat(cam + 0x56C, x - cosy * speed)
            writeFloat(cam + 0x570, y - siny * speed)
        end

        if isKeyPressed(VK_NUMPAD4) then
            writeFloat(cam + 0x56C, x + math.sin(yaw) * speed)
            writeFloat(cam + 0x570, y - math.cos(yaw) * speed)
        end

        if isKeyPressed(VK_NUMPAD6) then
            writeFloat(cam + 0x56C, x - math.sin(yaw) * speed)
            writeFloat(cam + 0x570, y + math.cos(yaw) * speed)
        end

        if isKeyPressed(VK_NUMPAD7) then
            writeFloat(cam + 0x574, z + speed)
        end

        if isKeyPressed(VK_NUMPAD9) then
            writeFloat(cam + 0x574, z - speed)
        end

        if isKeyPressed(VK_NUMPAD1) then
            writeInteger(cam + 0x580, rollI - rollStep)
        end

        if isKeyPressed(VK_NUMPAD3) then
            writeInteger(cam + 0x580, rollI + rollStep)
        end
    end


if camTimer then
    camTimer.destroy()
end

camTimer = createTimer(nil)
camTimer.Interval = 10
camTimer.OnTimer = checkKeys
{$asm}

[DISABLE]

Camera:
